# ---------------------------------------------------------------------------
# İç Hatlar — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp doldurun. .env asla depoya girmez.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Uygulamanın dışarıdan görünen adresi. Entra ID'ye kayıtlı redirect URI
# bununla birebir aynı olmak zorunda.
APP_URL=http://localhost:3000

# Kuruluşun adı — sekme başlığında ve kenar çubuğu alt bilgisinde görünür.
# Boş bırakılırsa yalnızca ürün adı (İç Hatlar) görünür.
ORG_NAME=

# ---------------------------------------------------------------------------
# Veritabanı — yalnızca PostgreSQL (≥ 15)
#   Yerel geliştirme: gömülü PostgreSQL (npm run db:local) — aşağıdaki değer
#   olduğu gibi çalışır, yalnızca bu makinede ve localhost'ta dinler.
#   Kuruluş sunucusu: BT'nin verdiği adres, ör.
#     postgresql://ichatlar_app:<parola>@db.kurum.local:5432/ichatlar?schema=public&sslmode=require
#   Veritabanı tr-TR ICU yerel ayarıyla oluşturulmalı (docs/KURULUM.md).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ichatlar:ichatlar-local@localhost:5433/ichatlar?schema=public

# ---------------------------------------------------------------------------
# ML veritabanı — ana veritabanından AYRI (prisma/ml/schema.prisma)
#   Modelin sürümleri, öğrendiği kelime ağırlıkları, her kontrol çağrısı,
#   ekip önerileri ve sonuçları burada tutulur.
#   SQLite dosyası; yol prisma/ml/schema.prisma dosyasına göre çözülür
#   ("../.." proje kökü). Erişilemezse uygulama çalışır, yalnızca ML kayıtları
#   tutulmaz.
# ---------------------------------------------------------------------------
ML_DATABASE_URL=file:../../var/ichatlar-ml.db
# Yeni veri gelmişse model bu aralıkla yeniden eğitilir (dakika).
ML_RETRAIN_MINUTES=30

# ---------------------------------------------------------------------------
# Oturum
# Rastgele 32+ bayt. Üretmek için:  openssl rand -base64 48
# Değiştirildiğinde tüm oturumlar düşer.
# ---------------------------------------------------------------------------
SESSION_SECRET=degistir-bunu-en-az-32-karakter-olmali-rastgele
SESSION_TTL_HOURS=12

# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) — kurumsal giriş
#
# BT'den istenecekler:
#   1. Entra portalında "App registration" (tek kiracı)
#   2. Redirect URI (Web):  ${APP_URL}/auth/callback
#   3. Client secret
#   4. Token yapılandırmasında opsiyonel claim: groups  (veya app roles)
#
# ENTRA_TENANT_ID: kiracı GUID'i
# ENTRA_CLIENT_ID: uygulama (client) GUID'i
# ---------------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Departman eşlemesi Entra gruplarından yapılacaksa true. false ise kullanıcı
# ilk girişte departmansız açılır ve yönetici elle atar.
ENTRA_USE_GROUPS=false

# Bu Entra grubundaki kişiler ADMIN rolü alır (grup nesne kimliği).
ENTRA_ADMIN_GROUP_ID=

# ---------------------------------------------------------------------------
# Geliştirme kolaylığı
# true veya false yazın; tanınmayan bir değer sunucuyu açılışta durdurur.
# true ise Entra atlanır, /auth/dev-login?email=... ile oturum açılır.
# NODE_ENV=production iken sunucu bu değeri yok sayar.
# ---------------------------------------------------------------------------
DEV_AUTH_BYPASS=true

# ---------------------------------------------------------------------------
# Dosya ekleri — yerel disk. S3/Azure Blob'a geçilecekse lib/storage.ts
# içindeki arayüz değiştirilir, çağıran kod aynı kalır.
# ---------------------------------------------------------------------------
STORAGE_DIR=./var/uploads
MAX_UPLOAD_MB=10

# --- Erişim kapısı ------------------------------------------------------
# Doluysa uygulamaya girmeden önce bu kod sorulur. İnternete açık test
# yayınında (Cloudflare tüneli) mutlaka doldurun; yerel çalışmada boş bırakın.
ACCESS_CODE=

# Geliştirme girişinde oturum yokken açılan kullanıcı (arayüzden değiştirilebilir).
DEV_DEFAULT_USER=omer.uygun@ornek.com

{
  "name": "ichatlar",
  "version": "0.1.0",
  "private": true,
  "description": "İç Hatlar — kurum içi bilgi ve öneri kayıt sistemi",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "prisma generate --schema prisma/ml/schema.prisma",
    "db:generate": "prisma generate && prisma generate --schema prisma/ml/schema.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ml:generate": "prisma generate --schema prisma/ml/schema.prisma",
    "ml:migrate": "prisma migrate dev --schema prisma/ml/schema.prisma",
    "ml:deploy": "prisma migrate deploy --schema prisma/ml/schema.prisma",
    "ml:studio": "prisma studio --schema prisma/ml/schema.prisma --port 5556",
    "ml:reset": "prisma migrate reset --force --skip-seed --schema prisma/ml/schema.prisma",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:local": "tsx scripts/local-db.ts start",
    "db:local:stop": "tsx scripts/local-db.ts stop",
    "db:local:status": "tsx scripts/local-db.ts status",
    "setup": "tsx src/cli/setup.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "openid-client": "^5.7.1",
    "pino": "^9.6.0",
    "prisma": "^6.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "embedded-postgres": "17.10.0-beta.17",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
